# Google Places API Key (optional - for real Google Maps review integration)
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# Set two distinct random keys before starting the backend. Generate each with:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SILENT_CHURN_API_TOKEN=
SILENT_CHURN_ADMIN_TOKEN=

# Set to production to disable the destructive sample-data endpoint entirely.
SILENT_CHURN_ENV=development
# For a deployed frontend, set its exact HTTPS origin here.
# SILENT_CHURN_ALLOWED_ORIGINS=https://example.com
